# Hosts that block automated link checkers or rate-limit aggressively.
^https?://(www\.)?linkedin\.com
^https?://(www\.)?x\.com
^https?://twitter\.com
# stripe blocks non-browser clients (docs.stripe.com serves a JS challenge).
^https?://([a-z0-9-]+\.)*stripe\.com
# visa/mastercard reference pages live on regional and developer subdomains
# (usa.visa.com, developer.visa.com, developer.mastercard.com).
^https?://([a-z0-9-]+\.)*visa\.com
^https?://([a-z0-9-]+\.)*mastercard\.com
^https?://(www\.)?namecheap\.com
# iso.org serves a Cloudflare challenge to non-browser clients (403).
^https?://(www\.)?iso\.org
# incomplete TLS chain; lychee's rustls rejects it, browsers don't
^https?://(www\.)?ctia\.org
