"    ID --> EC[\"5 Economic Identity\"]\n"
"    ID --> TR[\"9 Trust\"]\n"
"    PR --> AU\n"
"    AU --> CA[\"6 Capabilities\"]\n"
"    CO[\"4 Compute\"] --> CA\n"
"    CO --> ME[\"7 Memory\"]\n"
"    EC --> CA\n"
"    ID --> AT[\"8 Authority\"]\n"
"    AT --> CA\n"
"    AT --> EC\n"
"    CA --> TR\n"
"    AT --> GO[\"10 Governance\"]\n"
"    EC --> GO\n"
"    CO --> GO\n"
"    TR --> GO\n"
